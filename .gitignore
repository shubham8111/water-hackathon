# Allowlist: only the analysis scripts, report build files and the final report are tracked.
# Data, hackathon material, credentials and environments stay out.
/*
!/.gitignore
!/requirements.txt
!/README.md
!/src/
!/outputs/
/outputs/*
!/outputs/KRS_insights.html
!/outputs/Hemavathy_insights.html
/src/__pycache__/
!/outputs/final_report.html
!/outputs/presentation.html
